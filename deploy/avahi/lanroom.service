<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- 宿主机 Avahi 备用发布：即使 Hub 进程 mDNS 曾失败，局域网仍可发现 _lanroom._tcp -->
<service-group>
  <name replace-wildcards="yes">LanRoom on %h</name>
  <service>
    <type>_lanroom._tcp</type>
    <port>8787</port>
    <txt-record>app=ThreeEndTransmission</txt-record>
    <txt-record>ver=1</txt-record>
  </service>
</service-group>
